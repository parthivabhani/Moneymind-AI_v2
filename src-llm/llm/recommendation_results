'''
category,output_id,rater_id,relevance,specificity,coherence,overall
Expense Optimization,EXP-001,1,4,4,5,4
Expense Optimization,EXP-001,2,5,4,5,5
Expense Optimization,EXP-001,3,4,4,4,4
Expense Optimization,EXP-001,4,4,4,5,4
Expense Optimization,EXP-001,5,5,4,5,5
Cash Flow Management,CFM-001,1,5,4,5,5
...

import os
import json
import random
import numpy as np
import pandas as pd
from datetime import datetime, timezone

# ── Configuration ──
GEMINI_MODEL_NAME = "gemini-1.5-flash"  

RANDOM_SEED = 42
N_RATERS = 5
N_OUTPUTS_PER_CATEGORY = 50

CATEGORIES = [
    "Expense Optimization",
    "Cash Flow Management",
    "Risk Mitigation",
    "Revenue Enhancement",
    "Portfolio Diversification"
]

CRITERIA = ["relevance", "specificity", "coherence", "overall"]

RATINGS_PATH = "data/llm_recommendation_quality_ratings.csv"
OUTPUT_METADATA_PATH = "outputs/gemini_evaluation_metadata.json"
OUTPUT_TABLE_PATH = "outputs/table_llm_recommendation_quality.csv"
OUTPUT_PER_MODEL_TABLE_PATH = "outputs/table_llm_recommendation_quality_by_model.csv"

# ── Reproducibility / traceability ──
random.seed(RANDOM_SEED)
np.random.seed(RANDOM_SEED)
os.environ["PYTHONHASHSEED"] = str(RANDOM_SEED)

# ── Load real rater ratings ──
raw_scores = pd.read_csv(RATINGS_PATH)
raw_scores.columns = raw_scores.columns.str.strip().str.lower()

required_columns = [
    "category", "output_id", "rater_id", *CRITERIA
]

missing_columns = set(required_columns) - set(raw_scores.columns)
if missing_columns:
    raise ValueError(
        f"Missing required columns in {RATINGS_PATH}: {sorted(missing_columns)}"
    )

# Optional model column
HAS_MODEL_COLUMN = "model" in raw_scores.columns

if HAS_MODEL_COLUMN:
    raw_scores["model"] = raw_scores["model"].astype(str).str.strip()
    if raw_scores["model"].eq("").any() or raw_scores["model"].isna().any():
        raise ValueError(
            "The ratings file contains a 'model' column, but some model values are missing or blank."
        )

    MODELS = sorted(raw_scores["model"].unique())
else:
    MODELS = [GEMINI_MODEL_NAME]
    raw_scores["model"] = GEMINI_MODEL_NAME

# Validate categories
unexpected_categories = set(raw_scores["category"]) - set(CATEGORIES)
if unexpected_categories:
    raise ValueError(
        f"Unexpected categories found: {sorted(unexpected_categories)}"
    )

# Validate completeness
expected_rows = len(CATEGORIES) * N_OUTPUTS_PER_CATEGORY * N_RATERS * len(MODELS)

if len(raw_scores) != expected_rows:
    raise ValueError(
        f"Expected {expected_rows} rating records, but found {len(raw_scores)}.\n"
        f"Models detected: {MODELS}"
    )

rating_counts = (
    raw_scores
    .groupby(["model", "category", "output_id"])["rater_id"]
    .nunique()
)

if (rating_counts != N_RATERS).any():
    incomplete = rating_counts[rating_counts != N_RATERS]
    raise ValueError(
        "Some outputs were not rated by all raters:\n"
        f"{incomplete}"
    )

# Validate score range
for criterion in CRITERIA:
    raw_scores[criterion] = pd.to_numeric(
        raw_scores[criterion], errors="raise"
    )
    if not raw_scores[criterion].between(1, 5).all():
        raise ValueError(
            f"Invalid {criterion} scores detected; scores must be between 1 and 5."
        )

# ── Helper: format mean ± SD ──
def format_mean_sd(mean: float, sd: float) -> str:
    return f"{mean:.2f} ± {sd:.2f}"


# ── Compute original Table: category-level results across all models ──
category_summary = (
    raw_scores
    .groupby("category", sort=False)[CRITERIA]
    .agg(["mean", "std"])
)

formatted_rows = []

for category in CATEGORIES:
    row = {"Category": category}

    for criterion in CRITERIA:
        mean = category_summary.loc[category, (criterion, "mean")]
        sd = category_summary.loc[category, (criterion, "std")]
        row[criterion.title()] = format_mean_sd(mean, sd)

    formatted_rows.append(row)

overall_row = {"Category": "Overall Mean"}

for criterion in CRITERIA:
    overall_row[criterion.title()] = format_mean_sd(
        raw_scores[criterion].mean(),
        raw_scores[criterion].std(ddof=1)
    )

table = pd.DataFrame(formatted_rows + [overall_row])

table = table.rename(
    columns={
        "Relevance": "Relevance (5)",
        "Specificity": "Specificity (5)",
        "Coherence": "Coherence (5)",
        "Overall": "Overall (5)"
    }
)

# ── Compute per-model results ──
per_model_rows = []

for model_name in MODELS:
    model_scores = raw_scores[raw_scores["model"] == model_name]

    model_category_summary = (
        model_scores
        .groupby("category", sort=False)[CRITERIA]
        .agg(["mean", "std"])
    )

    for category in CATEGORIES:
        row = {
            "Model": model_name,
            "Category": category
        }

        for criterion in CRITERIA:
            mean = model_category_summary.loc[category, (criterion, "mean")]
            sd = model_category_summary.loc[category, (criterion, "std")]
            row[criterion.title()] = format_mean_sd(mean, sd)

        per_model_rows.append(row)

    model_overall_row = {
        "Model": model_name,
        "Category": "Overall Mean"
    }

    for criterion in CRITERIA:
        model_overall_row[criterion.title()] = format_mean_sd(
            model_scores[criterion].mean(),
            model_scores[criterion].std(ddof=1)
        )

    per_model_rows.append(model_overall_row)

per_model_table = pd.DataFrame(per_model_rows)

per_model_table = per_model_table.rename(
    columns={
        "Relevance": "Relevance (5)",
        "Specificity": "Specificity (5)",
        "Coherence": "Coherence (5)",
        "Overall": "Overall (5)"
    }
)

# ── Save results ──
os.makedirs(os.path.dirname(OUTPUT_TABLE_PATH), exist_ok=True)

table.to_csv(OUTPUT_TABLE_PATH, index=False)
per_model_table.to_csv(OUTPUT_PER_MODEL_TABLE_PATH, index=False)

# ── Save factual evaluation metadata ──
evaluation_metadata = {
    "model_identifier": GEMINI_MODEL_NAME,
    "api_provider": "Google Generative AI",
    "evaluation_timestamp_utc": datetime.now(timezone.utc).isoformat(),
    "random_seed": RANDOM_SEED,
    "ratings_source_file": RATINGS_PATH,
    "number_of_categories": len(CATEGORIES),
    "outputs_per_category": N_OUTPUTS_PER_CATEGORY,
    "number_of_raters": N_RATERS,
    "total_rating_records": int(len(raw_scores)),
    "rating_scale": "1-5",
    "criteria": CRITERIA,
    "model_column_present_in_ratings": HAS_MODEL_COLUMN,
    "models_evaluated": MODELS,
    "per_model_comparison_possible": HAS_MODEL_COLUMN,
    "per_model_results_file": (
        OUTPUT_PER_MODEL_TABLE_PATH if HAS_MODEL_COLUMN else None
    )
}

with open(OUTPUT_METADATA_PATH, "w") as f:
    json.dump(evaluation_metadata, f, indent=4)

print("Original category-level table:")
print(table.to_string(index=False))

print("\nPer-model results:")
if HAS_MODEL_COLUMN:
    print(per_model_table.to_string(index=False))
else:
    print(
        "The rating dataset does not include a model column, "
        "so per-model comparison was not possible for the original evaluation."
    )

print(f"\nSaved table: {OUTPUT_TABLE_PATH}")
print(f"Saved per-model table: {OUTPUT_PER_MODEL_TABLE_PATH}")
print(f"Saved metadata: {OUTPUT_METADATA_PATH}")
