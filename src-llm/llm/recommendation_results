import numpy as np
import pandas as pd

# ── Reproducibility ──
RANDOM_SEED = 42
np.random.seed(RANDOM_SEED)

# ── Configuration ──
N_RATERS = 5
N_OUTPUTS_PER_CATEGORY = 50
CATEGORIES = [
    "Expense Optimization",
    "Cash Flow Management",
    "Risk Mitigation",
    "Revenue Enhancement",
    "Portfolio Diversification"
]

CRITERIA = ["Relevance", "Specificity", "Coherence", "Overall"]

# ── Raw scores ──
# Each row represent one rater's evaluation of one LLM output.
#
# Required columns:
# category, output_id, rater_id,
# relevance, specificity, coherence, overall
#
# Example:
# ── Load actual LLM recommendation quality ratings ──
RAW_RATINGS_PATH = "data/llm_recommendation_quality_ratings.csv"
'''
category,output_id,rater_id,relevance,specificity,coherence,overall
Expense Optimization,EXP-001,1,4,4,5,4
Expense Optimization,EXP-001,2,5,4,5,5
Expense Optimization,EXP-001,3,4,4,4,4
Expense Optimization,EXP-001,4,4,4,5,4
Expense Optimization,EXP-001,5,5,4,5,5
Cash Flow Management,CFM-001,1,5,4,5,5
...


raw_scores = pd.read_csv(RAW_RATINGS_PATH)

# Standardize column names
raw_scores.columns = raw_scores.columns.str.strip().str.lower()

required_columns = [
    "category",
    "output_id",
    "rater_id",
    "relevance",
    "specificity",
    "coherence",
    "overall"
]

missing_columns = set(required_columns) - set(raw_scores.columns)
if missing_columns:
    raise ValueError(
        f"Missing required columns in {RAW_RATINGS_PATH}: {sorted(missing_columns)}"
    )

# Validate categories
unexpected_categories = set(raw_scores["category"]) - set(CATEGORIES)
if unexpected_categories:
    raise ValueError(
        f"Unexpected categories found: {sorted(unexpected_categories)}"
    )

# Validate completeness: 5 raters × 50 outputs per category
expected_rows = len(CATEGORIES) * N_OUTPUTS_PER_CATEGORY * N_RATERS

if len(raw_scores) != expected_rows:
    raise ValueError(
        f"Expected {expected_rows} rating records, but found {len(raw_scores)}."
    )

# Check that every output was rated by every rater
rating_counts = (
    raw_scores
    .groupby(["category", "output_id"])["rater_id"]
    .nunique()
)

if (rating_counts != N_RATERS).any():
    incomplete = rating_counts[rating_counts != N_RATERS]
    raise ValueError(
        "Some outputs do not have ratings from all raters:\n"
        f"{incomplete}"
    )

# Validate score ranges
score_columns = ["relevance", "specificity", "coherence", "overall"]

for col in score_columns:
    if not raw_scores[col].between(1, 5).all():
        invalid = raw_scores.loc[~raw_scores[col].between(1, 5), ["category", "output_id", "rater_id", col]]
        raise ValueError(
            f"Invalid {col} scores found (must be between 1 and 5):\n{invalid}"
        )

# Convert scores to numeric type
raw_scores[score_columns] = raw_scores[score_columns].apply(
    pd.to_numeric, errors="raise"
)

# ── Validation ──
assert len(raw_scores) == len(CATEGORIES) * N_OUTPUTS_PER_CATEGORY * N_RATERS
assert set(raw_scores["category"]) == set(CATEGORIES)

# ── Compute category-level mean ± SD ──
category_summary = (
    raw_scores
    .groupby("category", sort=False)[CRITERIA]
    .agg(["mean", "std"])
)

# Format as "mean ± sd"
formatted_rows = []

for category in CATEGORIES:
    row = {"Category": category}
    for criterion in CRITERIA:
        mean = category_summary.loc[category, (criterion, "mean")]
        sd = category_summary.loc[category, (criterion, "std")]
        row[criterion] = f"{mean:.2f} ± {sd:.2f}"
    formatted_rows.append(row)

table = pd.DataFrame(formatted_rows)

# ── Compute overall mean ± SD across all categories ──
overall_row = {"Category": "Overall Mean"}

for criterion in CRITERIA:
    mean = raw_scores[criterion].mean()
    sd = raw_scores[criterion].std(ddof=1)
    overall_row[criterion] = f"{mean:.2f} ± {sd:.2f}"

table = pd.concat(
    [table, pd.DataFrame([overall_row])],
    ignore_index=True
)

# ── Display ──
table.columns = [
    "Category",
    "Relevance (5)",
    "Specificity (5)",
    "Coherence (5)",
    "Overall (5)"
]

print(table.to_string(index=False))

# ── Save ──
table.to_csv("table_llm_recommendation_quality.csv", index=False)
